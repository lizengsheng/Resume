---
import { getCollection } from "astro:content";
import ProjectCard from "@/components/ProjectCard.astro";
import { siteConfig } from "@/config";
import Layout from "@/layouts/Layout.astro";
import { withBase } from "@/lib/paths";
import { sortProjects } from "@/lib/projects";

const allProjects = sortProjects(
  (await getCollection("projects", ({ data }) => !data.draft)).slice(),
);
const projects = allProjects
  .filter((project) => project.data.featured)
  .slice(0, siteConfig.home.maxFeaturedProjects);
const profileFacts = siteConfig.profile.facts.map((fact) => ({
  value: "source" in fact && fact.source === "projectCount" ? String(allProjects.length) : fact.value,
  label: fact.label,
}));
---

<Layout>
  <div class="page-shell home-page">
    <section class="profile-card" aria-labelledby="profile-name">
      <div class="profile-heading">
        <img
          class="profile-avatar"
          src={withBase(siteConfig.profile.avatar)}
          alt={siteConfig.profile.avatarAlt}
          width="160"
          height="160"
        />
        <div>
          <h1 id="profile-name">{siteConfig.profile.name}</h1>
          <p class="profile-headline">{siteConfig.profile.headline}</p>
          <p class="profile-intro">{siteConfig.profile.intro}</p>
        </div>
      </div>

      <dl class="profile-facts">
        {profileFacts.map((fact) => (
          <div>
            <dt>{fact.value}</dt>
            <dd>{fact.label}</dd>
          </div>
        ))}
      </dl>

      <div class="profile-actions">
        <a class="button-primary" href={withBase("/#projects")}>
          {siteConfig.home.viewProjectsLabel} <span aria-hidden="true">→</span>
        </a>
        <a class="button-secondary" href={withBase(siteConfig.links.resume)} target="_blank" rel="noreferrer">
          {siteConfig.home.resumeLabel} <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="profile-links" aria-label="个人链接">
        <span>{siteConfig.home.contactLabel}：</span>
        <a href={siteConfig.links.github} target="_blank" rel="noreferrer">GitHub</a>
        <a href={siteConfig.links.blog} target="_blank" rel="noreferrer">技术博客</a>
        <a href={`mailto:${siteConfig.links.email}`}>Email</a>
      </div>
    </section>

    <section class="home-section" id="projects" aria-labelledby="projects-title">
      <div class="content-heading">
        <h2 id="projects-title">{siteConfig.home.projectsTitle}</h2>
        <p>{siteConfig.home.projectsDescription}</p>
      </div>
      {projects.length > 0 ? (
        <div class="project-grid">
          {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
        </div>
      ) : (
        <p class="empty-state">暂时还没有公开的精选项目。</p>
      )}
      <a class="all-projects-link" href={withBase("/projects/")}>{siteConfig.home.allProjectsLabel} <span aria-hidden="true">→</span></a>
    </section>

    <section class="home-section" id="about" aria-labelledby="about-title">
      <div class="about-copy">
        <h2 id="about-title">{siteConfig.about.title}</h2>
        {siteConfig.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="about-section">
        <h3>技术能力</h3>
        <div class="skill-groups">
          {siteConfig.about.skillGroups.map((group) => (
            <article>
              <h4>{group.title}</h4>
              <div class="tag-list">{group.items.map((item) => <span>{item}</span>)}</div>
            </article>
          ))}
        </div>
      </div>
      <div class="about-section">
        <h3>教育背景</h3>
        <div class="education-list">
          {siteConfig.about.education.map((item) => (
            <article>
              <div><h4>{item.school}</h4><p>{item.detail}</p></div>
              <time>{item.period}</time>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
